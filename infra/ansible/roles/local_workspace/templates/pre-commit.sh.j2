#!/bin/bash
# Pre-commit hook generated by Ansible

echo "Running pre-commit checks..."

# Example: Run ruff check
if command -v ruff &> /dev/null
then
    echo "Checking Python code with ruff..."
    ruff check .
else
    echo "Ruff not found, skipping Python check."
fi

# Example: Run pnpm lint
if command -v pnpm &> /dev/null && [ -f "package.json" ]
then
    echo "Checking Node code with pnpm lint..."
    pnpm lint
fi

echo "Pre-commit checks passed!"
exit 0
