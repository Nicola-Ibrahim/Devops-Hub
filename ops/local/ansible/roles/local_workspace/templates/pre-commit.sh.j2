#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "${repo_root}"

if [[ -f backend/pyproject.toml ]]; then
  command -v uv >/dev/null || { echo "uv is required; install it before committing." >&2; exit 1; }
  cd "${repo_root}/backend"
  uv run --frozen ruff check src migrations tests
  uv run --frozen ruff format --check src migrations tests
fi

if [[ -f frontend/package.json ]]; then
  command -v npm >/dev/null || { echo "npm is required; install it before committing." >&2; exit 1; }
  cd "${repo_root}/frontend"
  npm run typecheck
fi
